NODE_ENV=development
PORT=3000
WEB_PORT=8080
DATABASE_URL=postgresql://sakura:CHANGE_ME@127.0.0.1:5432/sakura?schema=public
POSTGRES_USER=sakura
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sakura
REDIS_URL=redis://localhost:6379
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SEED_ADMIN_EMAIL=admin@sakura.local
SEED_ADMIN_NAME=Quản trị Sakura
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD


PUBLIC_WEB_ORIGIN=http://localhost:8080
TRUST_PROXY_HOPS=0

HOST=127.0.0.1

# Messenger is disabled until Meta application/Page setup is complete.
MESSENGER_ENABLED=false
MESSENGER_SEND_ENABLED=false
MESSENGER_PAGE_ID=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_GRAPH_VERSION=
# Independent 32-byte key encoded as 64 lowercase hex characters. Keep separately from database backups.
MESSENGER_CONFIG_KEY=

# Optional multi-Page configuration for Pages belonging to the same Meta app.
# Replaces the legacy PAGE_ID / PAGE_ACCESS_TOKEN pair when non-empty.
# JSON array: [{"pageId":"...","name":"Sakura","accessToken":"...","sendEnabled":false}]
MESSENGER_PAGES_JSON=
MESSENGER_PAGE_NAME=

# Optional absolute paths. Defaults are .local/media and .local/backups under the project.
MEDIA_ROOT=
BACKUP_ROOT=
# Directory containing official pg_dump and pg_restore, same major as the server or newer.
PG_BIN=
# Optional absolute path to local Drive/R2 backup configuration; no account keys in this file.
OFFSITE_CONFIG=
