# Production only. Do not replace the working local .env with this file.
SAKURA_RELEASE=REPLACE_RELEASE
SAKURA_DOMAIN=REPLACE_COMPANY_DOMAIN
SAKURA_BACKUP_DIR=/srv/sakura/backups
POSTGRES_USER=sakura
POSTGRES_DB=sakura
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
JWT_SECRET=REPLACE_JWT_SECRET
# For a restored database, retain its original MESSENGER_CONFIG_KEY instead of a new key.
MESSENGER_CONFIG_KEY=REPLACE_MESSENGER_CONFIG_KEY
SEED_ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
SEED_ADMIN_NAME=Quan tri Sakura
SEED_ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD
