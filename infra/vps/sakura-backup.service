[Unit]
Description=Verified Sakura database and image backup
Requires=sakura-db.service
After=sakura-db.service

[Service]
Type=oneshot
User=sakura
Group=sakura
Slice=sakura.slice
ExecStart=/srv/sakura/bin/backup.sh
Nice=15
IOSchedulingClass=idle
MemoryMax=160M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sakura/shared/backups
UMask=0077
