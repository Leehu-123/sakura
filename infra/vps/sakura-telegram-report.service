[Unit]
Description=Sakura daily Telegram sales report
Requires=sakura-db.service
After=sakura-db.service

[Service]
Type=oneshot
User=sakura
Group=sakura
Slice=sakura.slice
EnvironmentFile=/srv/sakura/shared/app.env
WorkingDirectory=/srv/sakura/current
ExecStart=/opt/sakura/node/bin/node /srv/sakura/current/scripts/ops/daily-telegram-report.cjs
MemoryMax=96M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
